// Example 2, step B: after make_self_node x4 and add_neighbor x4
digraph ex2_dof_1 {
  bgcolor=transparent; nodesep=0.7; forcelabels=true;
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor=white, shape=circle, width=0.45, fixedsize=true];
  edge [fontname="Helvetica", fontsize=10, color="#d62728", fontcolor="#d62728"];
  f [label="forest", shape=box, style="rounded,filled", fillcolor="#eeeeee", fixedsize=false];
  m1 [label="-1", xlabel=<<font color="#888888">G.entry</font>>]; n1 [label="1", xlabel=<<font color="#888888">ptr1</font>>];
  n2 [label="2", xlabel=<<font color="#888888">ptr2</font>>]; n3 [label="3", xlabel=<<font color="#888888">ptr3</font>>];
  f -> m1; f -> n1;
  f -> n2; f -> n3;
  m1:s -> m1:s [style=dashed, color="#2ca02c", fontcolor="#2ca02c"]; n1:s -> n1:s [style=dashed, color="#2ca02c", fontcolor="#2ca02c"];
  n2:s -> n2:s [style=dashed, color="#2ca02c", fontcolor="#2ca02c"]; n3:s -> n3:s [style=dashed, color="#2ca02c", fontcolor="#2ca02c"];
  m1 -> n1 [style=dashed, color="#2ca02c", fontcolor="#2ca02c", constraint=false];
  n1 -> n2 [style=dashed, color="#2ca02c", fontcolor="#2ca02c", constraint=false];
  n2 -> n3 [style=dashed, color="#2ca02c", fontcolor="#2ca02c", constraint=false];
  n3:se -> m1:sw [style=dashed, color="#2ca02c", fontcolor="#2ca02c", constraint=false];
}
