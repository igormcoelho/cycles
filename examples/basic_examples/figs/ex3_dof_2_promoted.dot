// Example 3: the temporary died; node 1 became child of -1 (via _next)
digraph ex3_dof_2 {
  bgcolor=transparent; forcelabels=true;
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor=white, shape=circle, width=0.45, fixedsize=true];
  edge [fontname="Helvetica", fontsize=9, color="#d62728", fontcolor="#d62728"];
  f [label="forest", shape=box, style="rounded,filled", fillcolor="#eeeeee", fixedsize=false];
  m1 [label="-1", xlabel=<<font color="#888888">L._entry</font>>]; n1 [label="1"];
  f -> m1;
  m1 -> n1 [label=" _next"];
  m1:w -> m1:w [style=dashed, color="#2ca02c", fontcolor="#2ca02c", label="self"]; n1:w -> n1:w [style=dashed, color="#2ca02c", fontcolor="#2ca02c", label="self"];
  n1:e -> m1:e [style=dashed, color="#2ca02c", fontcolor="#2ca02c", constraint=false, label=" _prev"];
}
