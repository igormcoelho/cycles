// Example 1, step C1: after ptr1.reset(), node 1 is promoted to child of -1
digraph ex1_dof_2 {
  bgcolor=transparent; nodesep=0.6; forcelabels=true;
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor=white, shape=circle, width=0.45, fixedsize=true];
  edge [fontname="Helvetica", fontsize=10, color="#d62728", fontcolor="#d62728"];
  f [label="forest", shape=box, style="rounded,filled", fillcolor="#eeeeee", fixedsize=false];
  m1 [label="-1", xlabel=<<font color="#888888">G.entry</font>>]; n1 [label="1"];
  n2 [label="2", xlabel=<<font color="#888888">ptr2</font>>]; n3 [label="3", xlabel=<<font color="#888888">ptr3</font>>];
  f -> m1; f -> n2; f -> n3;
  m1 -> n1;
  n1 -> n2 [style=dashed, color="#2ca02c", fontcolor="#2ca02c", constraint=false];
  n2 -> n3 [style=dashed, color="#2ca02c", fontcolor="#2ca02c", constraint=false];
  n3:s -> m1:e [style=dashed, color="#2ca02c", fontcolor="#2ca02c", constraint=false];
}
